@echo off
rem ============================================================
rem  start.bat —— 双击即用的静默启动脚本
rem  作用：用 pythonw.exe（无控制台）启动快速翻译器。
rem  %~dp0 表示"本 bat 所在目录"，这样无论从哪里双击，
rem  工作目录都会切到项目根，避免相对路径出错。
rem ============================================================
cd /d "%~dp0"
start "" "%~dp0venv\Scripts\pythonw.exe" "%~dp0main.py"
